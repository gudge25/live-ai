# ============================================================
# Live AI — configuration for docker-compose-nginx.yml
#   cp .env.example.nginx .env
#   docker compose -f docker-compose-nginx.yml up -d --build
# nginx is the only publicly exposed service:
#   443  wss://<PUBLIC_DOMAIN>/ui   (Chrome extension, Let's Encrypt TLS)
#   9092 AudioSocket from PBX_ALLOWED_* only (raw audio, not encrypted)
#   80   Let's Encrypt challenge + redirect
# Values left empty fall back to the defaults shown.
# ============================================================

# ---- nginx + Let's Encrypt ----
# Public hostname of this server (needs a DNS A record to it). No domain of your own?
# <ip-with-dashes>.sslip.io resolves to that IP, e.g. 203-0-113-10.sslip.io
PUBLIC_DOMAIN=203-0-113-10.sslip.io
# Let's Encrypt expiry notices go here (empty = register without an email)
LETSENCRYPT_EMAIL=
# true = Let's Encrypt staging (untrusted cert, no rate limits) — for testing the flow
LETSENCRYPT_STAGING=false
# Only these sources may connect to the AudioSocket port (9092); everyone else is rejected.
# Comma-separated IPv4 addresses/CIDRs and/or hostnames (IPv4 only) — hostnames are
# re-resolved every 30s.
# Leave both empty and nobody can connect.
PBX_ALLOWED_IPS=
PBX_ALLOWED_HOSTS=pbx.example.com

# ---- Asterisk ARI (Asterisk 18) ----
# Base URL of the Asterisk HTTP server (no /ari suffix). https => events use wss://
ARI_URL=https://pbx.example.com:8089
ARI_USER=liveai
ARI_PASSWORD=change-me
# Stasis application name (created automatically on connect)
ARI_APP=live-ai
# Path (inside the container: /certs/...) to the CA that signed the PBX certificate
ARI_CA_CERT=
# Skip TLS verification — development only!
ARI_TLS_INSECURE=false
# Receive all ARI events instead of per-endpoint subscriptions (fallback, noisy on busy PBXs)
ARI_SUBSCRIBE_ALL=false

# ---- Monitoring ----
# Comma-separated extensions to transcribe
MONITORED_EXTENSIONS=222
# Channel technology of those extensions (PJSIP or SIP)
CHANNEL_TECH=PJSIP

# ---- AudioSocket (Asterisk -> this service, TCP) ----
# Listen address (fixed to 0.0.0.0:9092 inside docker compose)
AUDIOSOCKET_BIND=0.0.0.0:9092
# host:port Asterisk dials — nginx's public :9092 (this server's IP or PUBLIC_DOMAIN, plus :9092).
# nginx forwards it to live-ai and only accepts PBX_ALLOWED_* sources.
AUDIOSOCKET_ADVERTISE_HOST=203.0.113.10:9092

# ---- AssemblyAI (Universal-Streaming v3) ----
ASSEMBLYAI_API_KEY=
# universal-streaming-english ($0.15/hr per stream) or universal-3-5-pro ($0.45/hr, more accurate)
AAI_SPEECH_MODEL=universal-streaming-english
AAI_LANGUAGE_CODES=en
# Optional comma-separated terms to bias recognition (product names, etc.)
AAI_KEYTERMS=
# Experimental: one dual-channel AAI session per call instead of one per side
AAI_DUAL_CHANNEL=false
AAI_MAX_CONCURRENT_SESSIONS=20
# Post-call summary via AssemblyAI LLM Gateway (same API key, no extra cost setup)
AAI_SUMMARY_ENABLED=false
AAI_SUMMARY_MODEL=qwen3.5-4b-32k-fast
AAI_SUMMARY_TIMEOUT_MS=10000
AAI_SUMMARY_SYSTEM_PROMPT=Summarize this phone call transcript for an operator glancing at it after the call. Plain text only, no markdown, no headers, no bold, no asterisks. 2-4 short sentences covering: what the call was about, what the caller wanted, and any action items.

# ---- UI WebSocket (Chrome extension) ----
UI_BIND=0.0.0.0
UI_PORT=8765
# Shared secret the extension sends as ?token=... (min 16 chars). Generate: openssl rand -hex 24
UI_TOKEN=
# How many ended calls to keep in memory for newly connected clients
UI_HISTORY_LIMIT=20

# ---- Logging ----
LOG_LEVEL=info
# Write final transcript text into logs (off by default for privacy)
LOG_TRANSCRIPTS=false
