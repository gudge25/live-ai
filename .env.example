# ============================================================
# Live AI — configuration. Copy to .env and fill in.
# Values left empty fall back to the defaults shown.
# ============================================================

# ---- Asterisk ARI (Asterisk 18) ----
# Base URL of the Asterisk HTTP server (no /ari suffix). https => events use wss://
ARI_URL=https://pbx.example.com:8089
ARI_USER=liveai
ARI_PASSWORD=change-me
# Stasis application name (created automatically on connect)
ARI_APP=live-ai
# Path (inside the container: /certs/...) to the CA that signed the PBX certificate
ARI_CA_CERT=
# Skip TLS verification — development only!
ARI_TLS_INSECURE=false
# Receive all ARI events instead of per-endpoint subscriptions (fallback, noisy on busy PBXs)
ARI_SUBSCRIBE_ALL=false

# ---- Monitoring ----
# Comma-separated extensions to transcribe
MONITORED_EXTENSIONS=222
# Channel technology of those extensions (PJSIP or SIP)
CHANNEL_TECH=PJSIP

# ---- AudioSocket (Asterisk -> this service, TCP) ----
# Listen address (fixed to 0.0.0.0:9092 inside docker compose)
AUDIOSOCKET_BIND=0.0.0.0:9092
# host:port Asterisk must connect to: IP of the docker host + AUDIOSOCKET_PUBLISH_PORT
AUDIOSOCKET_ADVERTISE_HOST=192.168.1.50:9092

# ---- AssemblyAI (Universal-Streaming v3) ----
ASSEMBLYAI_API_KEY=
# universal-streaming-english ($0.15/hr per stream) or universal-3-5-pro ($0.45/hr, more accurate)
AAI_SPEECH_MODEL=universal-streaming-english
AAI_LANGUAGE_CODES=en
# Optional comma-separated terms to bias recognition (product names, etc.)
AAI_KEYTERMS=
# Experimental: one dual-channel AAI session per call instead of one per side
AAI_DUAL_CHANNEL=false
AAI_MAX_CONCURRENT_SESSIONS=20

# ---- UI WebSocket (Chrome extension) ----
UI_BIND=0.0.0.0
UI_PORT=8765
# Shared secret the extension sends as ?token=... (min 16 chars). Generate: openssl rand -hex 24
UI_TOKEN=
# How many ended calls to keep in memory for newly connected clients
UI_HISTORY_LIMIT=20

# ---- docker compose published ports ----
UI_PUBLISH_PORT=8765
AUDIOSOCKET_PUBLISH_PORT=9092

# ---- Logging ----
LOG_LEVEL=info
# Write final transcript text into logs (off by default for privacy)
LOG_TRANSCRIPTS=false
