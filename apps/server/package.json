{
  "name": "@live-ai/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "mock-events": "tsx --env-file-if-exists=../../.env src/dev/mock-events.ts"
  },
  "dependencies": {
    "@live-ai/shared": "workspace:*",
    "assemblyai": "^4.41.5",
    "pino": "^10.3.1",
    "undici": "^8.11.2",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
